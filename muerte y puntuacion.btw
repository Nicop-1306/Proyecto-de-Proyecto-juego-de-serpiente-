@CODE lang=arduino lines=142
| #include <Adafruit_GFX.h>
| #include <Adafruit_ST7735.h>
| #include <SPI.h>
| 
| #define TFT_CS 10
| #define TFT_DC 9
| #define TFT_RST 8
| 
| Adafruit_ST7735 pantalla = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);
| 
| int serpientepos[] = {65, 70}; // Vector de posición de la serpiente [X, Y]
| int velocidad = 4; // Cantidad de píxeles que se mueve en cada paso
| 
| const int PIN_JOYSTICK_X = A0; // Eje X
| const int PIN_JOYSTICK_Y = A1; // Eje Y
| bool vivo = false; //Revisa si murio la serpiente (cuando choque se vuelve false)
| int puntuacion = 0;
| 
| enum Direccion { ARRIBA, ABAJO, IZQUIERDA, DERECHA };
| Direccion dirActual = ARRIBA; // Dirección inicial
| 
| void setup() {
|   pantalla.initR(INITR_BLACKTAB);
|   pantalla.fillScreen(ST77XX_WHITE); // Pantalla en blanco
| }
| 
| void loop() {
|   int valorX = analogRead(PIN_JOYSTICK_X);
|   int valorY = analogRead(PIN_JOYSTICK_Y);
|   
|    pantalla.setCursor(60, 10);
|    pantalla.setTextColor(ST77XX_BLACK, ST77XX_WHITE); // <--- Texto negro, fondo blanco
|    pantalla.println(puntuacion);
|    puntuacion++; //Como no hay manzanas,probamos con puntuacion++
|   
|   if(vivo == false)
|   {
|     borrarSerpiente();
|     serpientepos[0] = 65;
|     serpientepos[1] = 70;
|     
|     pantalla.setCursor(35, 50);
|     pantalla.setTextColor(ST77XX_BLACK, ST77XX_WHITE); // <--- Texto negro, fondo blanco
|     pantalla.println("Has muerto");
|     delay(1000);
|     pantalla.setCursor(35, 50);
|     pantalla.setTextColor(ST77XX_WHITE, ST77XX_WHITE); // <--- Texto blanco, fondo blanco para borrar
|     pantalla.println("Has muerto");
|     vivo = true;
|     
|   }
| 
|   // 1. SOLO DETECTAMOS EL CAMBIO DE DIRECCIÓN (Sin mover aún)
|   if (valorX < 200 && dirActual != DERECHA) {
|     dirActual = IZQUIERDA;
|   } 
|   else if (valorX > 800 && dirActual != IZQUIERDA) {
|     dirActual = DERECHA;
|   } 
|   else if (valorY < 200 && dirActual != ABAJO) {
|     dirActual = ARRIBA;
|   } 
|   else if (valorY > 800 && dirActual != ARRIBA) {
|     dirActual = ABAJO;
|   }
| 
|   // 2. EJECUTAMOS EL MOVIMIENTO AUTOMÁTICO EN CADA CICLO
|   borrarSerpiente();
| 
|   switch (dirActual) {
|     case ARRIBA:    moverArriba();    break;
|     case ABAJO:     moverAbajo();     break;
|     case IZQUIERDA: moverIzquierda(); break;
|     case DERECHA:   moverDerecha();   break;
|   }
| 
|   dibujarSerpiente();
| 
|   // 3. CONTROL DE VELOCIDAD CONSTANTE
|   delay(150); 
| }
| 
| // --- FUNCIONES DE MOVIMIENTO (Solo actualizan la posición) ---
| void moverArriba() {
|   serpientepos[1] -= velocidad;
| }
| 
| void moverAbajo() {
|   serpientepos[1] += velocidad;
| }
| 
| void moverIzquierda() {
|   serpientepos[0] -= velocidad;
| }
| 
| void moverDerecha() {
|   serpientepos[0] += velocidad;
| }
| 
| // --- FUNCIONES DE DIBUJO Y LIMPIEZA ---
| void dibujarSerpiente() {
|   int x = serpientepos[0];
|   int y = serpientepos[1];
| 
|   // 1. Dibuja el Cuerpo
|   if (dirActual == ARRIBA)    pantalla.fillRect(x - 2, y + 3, 5, 3, ST77XX_GREEN);
|   if (dirActual == ABAJO)     pantalla.fillRect(x - 2, y - 5, 5, 3, ST77XX_GREEN);
|   if (dirActual == IZQUIERDA) pantalla.fillRect(x + 3, y - 2, 3, 5, ST77XX_GREEN);
|   if (dirActual == DERECHA)   pantalla.fillRect(x - 5, y - 2, 3, 5, ST77XX_GREEN);
| 
|   // 2. Dibuja Cabeza
|   pantalla.fillCircle(x, y, 3, ST77XX_GREEN);
| 
|   // 3. Dibuja Ojos y Lengua según dirección
|   switch (dirActual) {
|     case ARRIBA:
|       pantalla.drawPixel(x - 2, y - 1, ST77XX_BLACK);
|       pantalla.drawPixel(x + 2, y - 1, ST77XX_BLACK);
|       pantalla.drawLine(x, y - 2, x, y - 4, ST77XX_RED);
|       break;
|     case ABAJO:
|       pantalla.drawPixel(x - 2, y + 1, ST77XX_BLACK);
|       pantalla.drawPixel(x + 2, y + 1, ST77XX_BLACK);
|       pantalla.drawLine(x, y + 2, x, y + 4, ST77XX_RED);
|       break;
|     case IZQUIERDA:
|       pantalla.drawPixel(x - 1, y - 2, ST77XX_BLACK);
|       pantalla.drawPixel(x - 1, y + 2, ST77XX_BLACK);
|       pantalla.drawLine(x - 2, y, x - 4, y, ST77XX_RED);
|       break;
|     case DERECHA:
|       pantalla.drawPixel(x + 1, y - 2, ST77XX_BLACK);
|       pantalla.drawPixel(x + 1, y + 2, ST77XX_BLACK);
|       pantalla.drawLine(x + 2, y, x + 4, y, ST77XX_RED);
|       break;
|   }
| }
| 
| void borrarSerpiente() {
|   pantalla.fillRect(serpientepos[0] - 7, serpientepos[1] - 7, 14, 14, ST77XX_WHITE);
| }
| 
@END parts=4 wires=15 crc32=8F343889
