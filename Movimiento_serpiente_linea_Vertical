#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>

#define TFT_CS  10
#define TFT_DC  9
#define TFT_RST 8
Adafruit_ST7735 pantalla = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);
int serpientepos[] = {65,70}; //Vector de posicion de la serpiente

void setup() 
{
  pantalla .initR(INITR_BLACKTAB);
  pantalla .fillScreen(ST77XX_WHITE); //Pantalla en blanco
  
}

void loop() 
{
  //Cuadrado blanco que "persigue" a la serpiente para borrar los pixeles que deja atras cada vez que se vuelve a dibujar
  pantalla.fillRect(serpientepos[0] - 3,serpientepos[1]+10,7,15,ST77XX_WHITE);
  delay(1000); //delay para ver paso por paso mas despacio,opcional

//Dibuja Cabeza
  pantalla .fillCircle(serpientepos[0],serpientepos[1],3, ST77XX_GREEN);

//Dibuja Cuerpo
   pantalla.fillRect(serpientepos[0]-2,serpientepos[1]+3, 5, 10, ST77XX_GREEN);

//Dibuja Ojo 1
  pantalla.drawPixel(serpientepos[0]-2,serpientepos[1]-1, ST77XX_BLACK);

//Dibuja Ojo 2
  pantalla.drawPixel(serpientepos[0]+2,serpientepos[1]-1, ST77XX_BLACK);

//Dibuja Lengua
  pantalla.drawLine(serpientepos[0], serpientepos[1]-2, serpientepos[0], serpientepos[1]-3, ST77XX_RED);

serpientepos[1]--; //Baja el eje Y para que se vuelva a dibujar todo más arriba
}

