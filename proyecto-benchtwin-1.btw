@CODE lang=arduino lines=227
| #include <Adafruit_GFX.h>
| #include <Adafruit_ST7735.h>
| #include <SPI.h>
| 
| #define TFT_CS 10
| #define TFT_DC 9
| #define TFT_RST 8
| 
| Adafruit_ST7735 pantalla = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);
| 
| // VARIABLES COMPARTIDAS Y DE CONFIGURACIÓN
| int serpientepos[] = {65, 70}; // La posición de la serpiente [X, Y]
| int velocidad = 4;             // Cantidad de píxeles que se mueve en cada paso
| 
| // PINES DEL JOYSTICK
| const int PIN_JOYSTICK_X = A0; // Eje X para cambiar de nivel e ir Izq/Der
| const int PIN_JOYSTICK_Y = A1; // Eje Y para arrancar el juego e ir Arriba/Abajo
| 
| int nivel = 1;
| bool juegoIniciado = false; // Controla si el juego empezó o está en el menú
| 
| // DIRECCIONES DE LA SERPIENTE
| enum Direccion { ARRIBA, ABAJO, IZQUIERDA, DERECHA };
| Direccion dirActual = ARRIBA; // Dirección inicial al arrancar la partida
| 
| void setup() {
|   pantalla.initR(INITR_BLACKTAB);
|   pantalla.fillScreen(ST77XX_WHITE); // Dibujar menú por primera vez
|   mostrarMenuInicial();
| }
| 
| void loop() {
|   // Leer los valores reales del Joystick (rango 15 a 1015)
|   int valorX = analogRead(PIN_JOYSTICK_X);
|   int valorY = analogRead(PIN_JOYSTICK_Y);
| 
|   if (!juegoIniciado) {
|     // === MODO SELECCIÓN DE NIVEL ===
|     // Si mueven el joystick hacia adelante/arriba (Eje Y cerca del mínimo)
|     if (valorY < 200) {
|       juegoIniciado = true;
|       dirActual = ARRIBA; // Reiniciar dirección por defecto al arrancar
|       comenzarJuego();    // Inicia la partida y dibuja los obstáculos
|     }
| 
|     // Si mueven el joystick a la izquierda y el nivel es mayor a 1
|     if (valorX < 200 && nivel > 1) {
|       nivel--; // Baja un nivel
|       actualizarMenu();
|       delay(300); // Delay anti-rebote indispensable
|     }
|     // Si mueven el joystick a la derecha y el nivel es menor a 3
|     else if (valorX > 850 && nivel < 3) {
|       nivel++; // Sube un nivel
|       actualizarMenu();
|       delay(300); // Delay anti-rebote indispensable
|     }
|     delay(30); // Estabilidad en lecturas de menú
|   } else {
|     // === MODO JUEGO EN MARCHA ===
|     // 1. SOLO DETECTAMOS EL CAMBIO DE DIRECCIÓN (Sin mover aún)
|     if (valorX < 200 && dirActual != DERECHA) {
|       dirActual = IZQUIERDA;
|     } else if (valorX > 800 && dirActual != IZQUIERDA) {
|       dirActual = DERECHA;
|     } else if (valorY < 200 && dirActual != ABAJO) {
|       dirActual = ARRIBA;
|     } else if (valorY > 800 && dirActual != ARRIBA) {
|       dirActual = ABAJO;
|     }
| 
|     // 2. EJECUTAMOS EL MOVIMIENTO AUTOMÁTICO EN CADA CICLO
|     borrarSerpiente(); // Borra en la posición actual antes de actualizarla
| 
|     switch (dirActual) {
|       case ARRIBA:    moverArriba();    break;
|       case ABAJO:     moverAbajo();     break;
|       case IZQUIERDA: moverIzquierda(); break;
|       case DERECHA:   moverDerecha();   break;
|     }
| 
|     dibujarSerpiente(); // Dibuja en la nueva posición
| 
|     // 3. CONTROL DE VELOCIDAD CONSTANTE
|     delay(150);
|     borrarSerpiente(); // Borra en la posición actual antes de actualizarla
|   }
| }
| 
| // --- FUNCIONES DEL MENÚ ---
| void mostrarMenuInicial() {
|   pantalla.setTextColor(ST77XX_BLACK); // Color del texto
|   pantalla.setTextSize(3);             // Tamaño del texto
|   pantalla.setCursor(25, 35);          // Posición en la pantalla (X, Y)
|   pantalla.print("Nivel");
| 
|   pantalla.setTextColor(ST77XX_BLACK);
|   pantalla.setTextSize(3);
|   pantalla.setCursor(58, 105);
|   pantalla.print("1");
|   pantalla.setCursor(38, 105);
|   pantalla.print("<");
|   pantalla.setCursor(78, 105);
|   pantalla.print(">");
| 
|   // Dibujar la serpiente quieta en el menú
|   pantalla.fillCircle(serpientepos[0], serpientepos[1], 3, ST77XX_GREEN); // cabeza
|   pantalla.fillRect(serpientepos[0] - 2, serpientepos[1] + 3, 5, 3, ST77XX_GREEN); // cuerpo
|   pantalla.drawPixel(serpientepos[0] - 2, serpientepos[1] - 1, ST77XX_BLACK); // ojo 1
|   pantalla.drawPixel(serpientepos[0] + 2, serpientepos[1] - 1, ST77XX_BLACK); // ojo 2
|   pantalla.drawLine(serpientepos[0], serpientepos[1] - 2, serpientepos[0], serpientepos[1] - 3, ST77XX_RED); // boca
| }
| 
| void actualizarMenu() {
|   // Borrar número anterior y limpiar la zona central de la serpiente
|   pantalla.fillRect(58, 105, 18, 22, ST77XX_WHITE);
|   pantalla.fillRect(50, 60, 30, 35, ST77XX_WHITE);
| 
|   // Dibujar número actual (1, 2 o 3)
|   pantalla.setTextColor(ST77XX_BLACK);
|   pantalla.setTextSize(3);
|   pantalla.setCursor(58, 105);
|   pantalla.print(nivel);
| 
|   // Dibujar la serpiente quieta de fondo de pantalla
|   pantalla.fillCircle(serpientepos[0], serpientepos[1], 3, ST77XX_GREEN);
|   pantalla.fillRect(serpientepos[0] - 2, serpientepos[1] + 3, 5, 3, ST77XX_GREEN);
|   pantalla.drawPixel(serpientepos[0] - 2, serpientepos[1] - 1, ST77XX_BLACK);
|   pantalla.drawPixel(serpientepos[0] + 2, serpientepos[1] - 1, ST77XX_BLACK);
|   pantalla.drawLine(serpientepos[0], serpientepos[1] - 2, serpientepos[0], serpientepos[1] - 3, ST77XX_RED);
| }
| 
| void comenzarJuego() {
|   pantalla.fillScreen(ST77XX_WHITE); // Limpiamos la pantalla del menú por completo
| 
|   // Volver a centrar la serpiente al iniciar la partida
|   serpientepos[0] = 65;
|   serpientepos[1] = 70;
| 
|   // Nivel 1: No genera ningún bloque negro (Mapa despejado)
|   // Si eligió el nivel 2, se dibujan los obstáculos en las esquinas y abajo
|   if (nivel == 2) {
|     pantalla.fillRect(0, 0, 30, 30, ST77XX_BLACK);     // Bloque fijo 1 (Arriba Izquierda)
|     pantalla.fillRect(103, 0, 25, 25, ST77XX_BLACK);   // Bloque fijo 2 (Arriba Derecha)
|     pantalla.fillRect(0, 120, 30, 50, ST77XX_BLACK);   // Bloque fijo 3 (Abajo Centro)
|   }
|   // Si eligió el nivel 3, se dibuja un gran obstáculo central (Laberinto/Cruz)
|   else if (nivel == 3) {
|     pantalla.fillRect(50, 0, 90, 15, ST77XX_BLACK);    // Bloque Arriba
|     pantalla.fillRect(54, 130, 80, 35, ST77XX_BLACK);  // Bloque Abajo
|     pantalla.fillRect(10, 60, 23, 75, ST77XX_BLACK);   // Bloque Izquierda
|   }
| 
|   // Redibujar la serpiente en su posición de inicio de partida
|   dibujarSerpiente();
| }
| 
| // --- FUNCIONES DE MOVIMIENTO ---
| void moverArriba()    { serpientepos[1] -= velocidad; }
| void moverAbajo()     { serpientepos[1] += velocidad; }
| void moverIzquierda() { serpientepos[0] -= velocidad; }
| void moverDerecha()   { serpientepos[0] += velocidad; }
| 
| // --- FUNCIONES DE DIBUJO Y LIMPIEZA ---
| void dibujarSerpiente() {
|   int x = serpientepos[0];
|   int y = serpientepos[1];
| 
|   // 1. Dibuja el Cuerpo
|   if (dirActual == ARRIBA)    pantalla.fillRect(x - 2, y + 3, 5, 3, ST77XX_GREEN);
|   if (dirActual == ABAJO)     pantalla.fillRect(x - 2, y - 5, 5, 3, ST77XX_GREEN);
|   if (dirActual == IZQUIERDA) pantalla.fillRect(x + 3, y - 2, 3, 5, ST77XX_GREEN);
|   if (dirActual == DERECHA)   pantalla.fillRect(x - 5, y - 2, 3, 5, ST77XX_GREEN);
| 
|   // 2. Dibuja Cabeza
|   pantalla.fillCircle(x, y, 3, ST77XX_GREEN);
| 
|   // 3. Dibuja Ojos y Lengua según dirección
|   switch (dirActual) {
|     case ARRIBA:
|       pantalla.drawPixel(x - 2, y - 1, ST77XX_BLACK);
|       pantalla.drawPixel(x + 2, y - 1, ST77XX_BLACK);
|       pantalla.drawLine(x, y - 2, x, y - 4, ST77XX_RED);
|       break;
|     case ABAJO:
|       pantalla.drawPixel(x - 2, y + 1, ST77XX_BLACK);
|       pantalla.drawPixel(x + 2, y + 1, ST77XX_BLACK);
|       pantalla.drawLine(x, y + 2, x, y + 4, ST77XX_RED);
|       break;
|     case IZQUIERDA:
|       pantalla.drawPixel(x - 1, y - 2, ST77XX_BLACK);
|       pantalla.drawPixel(x - 1, y + 2, ST77XX_BLACK);
|       pantalla.drawLine(x - 2, y, x - 4, y, ST77XX_RED);
|       break;
|     case DERECHA:
|       pantalla.drawPixel(x + 1, y - 2, ST77XX_BLACK);
|       pantalla.drawPixel(x + 1, y + 2, ST77XX_BLACK);
|       pantalla.drawLine(x + 2, y, x + 4, y, ST77XX_RED);
|       break;
|   }
| }
| 
| // NUEVA FUNCIÓN OPTIMIZADA: Borra usando las dimensiones exactas orientadas a la dirección actual
| void borrarSerpiente() {
|   int x = serpientepos[0];
|   int y = serpientepos[1];
| 
|   switch (dirActual) {
|     case ARRIBA:
|       // Cubre cabeza, lengua (hacia arriba) y cuerpo (hacia abajo)
|       pantalla.fillRect(x - 4, y -8, 9, 14, ST77XX_WHITE);
|       break;
|     case ABAJO:
|       // Cubre cabeza, lengua (hacia abajo) y cuerpo (hacia arriba)
|       pantalla.fillRect(x - 4, y-5, 9, 14, ST77XX_WHITE);
|       break;
|     case IZQUIERDA:
|       // Cubre cabeza, lengua (hacia la izquierda) y cuerpo (hacia la derecha)
|       pantalla.fillRect(x - 8, y - 4, 14, 9, ST77XX_WHITE);
|       break;
|     case DERECHA:
|       // Cubre cabeza, lengua (hacia la derecha) y cuerpo (hacia la izquierda)
|       pantalla.fillRect(x - 5, y - 4, 14, 9, ST77XX_WHITE);
|       break;
|   }
| }
| 
@END parts=4 wires=15 crc32=EC8AD00E
