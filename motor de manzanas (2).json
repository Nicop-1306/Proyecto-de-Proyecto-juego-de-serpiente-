 "code": "#include <Adafruit_GFX.h>\n#include <Adafruit_ST7735.h>\n#include <SPI.h>\n\n#define TFT_CS 10\n#define TFT_DC 9\n#define TFT_RST 8\n#define motor 7\n\nAdafruit_ST7735 pantalla = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);\n\n// DIMENSIONES DE LA PANTALLA ST7735\nconst int ANCHO_PANTALLA = 128;\nconst int ALTO_PANTALLA = 160;\n\n// VARIABLES DE LA SERPIENTE ARTICULADA\nconst int MAX_LARGO = 60;      // Largo máximo de segmentos\nint cuerpoX[MAX_LARGO];        // Posiciones X de cada parte del cuerpo\nint cuerpoY[MAX_LARGO];        // Posiciones Y de cada parte del cuerpo\nint largoActual = 3;           // Cantidad de segmentos (empieza con 3)\nint velocidad = 5;             // Distancia entre segmentos (5px evita huecos)\n\n// VARIABLES DE LAS MANZANAS\nconst int cantidadmanzanas = 3;\nint manzanaX[cantidadmanzanas];\nint manzanaY[cantidadmanzanas];\n\n// PINES DEL JOYSTICK\nconst int PIN_JOYSTICK_X = A0; \nconst int PIN_JOYSTICK_Y = A1; \n\nint nivel = 1;\nbool juegoIniciado = false; \nint puntuacion = 0;\n\n// DIRECCIONES DE LA SERPIENTE\nenum Direccion { ARRIBA, ABAJO, IZQUIERDA, DERECHA };\nDireccion dirActual = ARRIBA;\n\nvoid setup() {\n  pantalla.initR(INITR_BLACKTAB);\n  pantalla.fillScreen(ST77XX_WHITE);\n  randomSeed(analogRead(A2));\n  mostrarMenuInicial();\n  \n  pinMode(motor,OUTPUT);\n  \n}\n\nvoid loop() {\n  int valorX = analogRead(PIN_JOYSTICK_X);\n  int valorY = analogRead(PIN_JOYSTICK_Y);\n\n  if (!juegoIniciado) {\n    // === MODO SELECCIÓN DE NIVEL ===\n    if (valorY < 200) {\n      juegoIniciado = true;\n      dirActual = ARRIBA; \n      largoActual = 3;\n      puntuacion = 0;     \n      comenzarJuego();    \n    }\n\n    if (valorX < 200 && nivel > 1) {\n      nivel--; \n      actualizarMenu();\n      delay(300); \n    }\n    else if (valorX > 850 && nivel < 3) {\n      nivel++; \n      actualizarMenu();\n      delay(300); \n    }\n    delay(30); \n  } \n  else {\n    // === MODO JUEGO EN MARCHA ===\n    \n    // Mostrar puntuación en pantalla\n    pantalla.setCursor(5, 5);\n    pantalla.setTextColor(ST77XX_BLACK, ST77XX_WHITE);\n    pantalla.setTextSize(1);\n    pantalla.print(\"Score: \");\n    pantalla.print(puntuacion);\n    puntuacion++; \n\n    // 1. DETECTAMOS EL CAMBIO DE DIRECCIÓN\n    if (valorX < 200 && dirActual != DERECHA) {\n      dirActual = IZQUIERDA;\n    } else if (valorX > 800 && dirActual != IZQUIERDA) {\n      dirActual = DERECHA;\n    } else if (valorY < 200 && dirActual != ABAJO) {\n      dirActual = ARRIBA;\n    } else if (valorY > 800 && dirActual != ARRIBA) {\n      dirActual = ABAJO;\n    }\n\n    // 2. BORRAMOS SOLO LA PUNTA DE LA COLA Y LA LENGUA ANTERIOR\n    borrarCola();\n\n    // 3. DESPLAZAMOS EL CUERPO Y MOVEMOS LA CABEZA\n    moverSerpiente();\n\n    // 4. REVISAR SI CHOCÓ BORDES, OBSTÁCULOS O CONSIGO MISMA\n    if (verificarMuerte()) {\n      motorManzanas();\n      pantalla.fillScreen(ST77XX_WHITE);\n      pantalla.setCursor(20, 50);\n      pantalla.setTextColor(ST77XX_BLACK, ST77XX_WHITE);\n      pantalla.setTextSize(2);\n      pantalla.println(\"MORISTE\");\n      pantalla.setCursor(25, 70);\n      pantalla.println(\"Puntos:\");\n      pantalla.setCursor(60, 100);\n      pantalla.println(puntuacion);\n      delay(3000);\n      pantalla.fillScreen(ST77XX_WHITE);\n      juegoIniciado = false;\n      mostrarMenuInicial();\n      return; \n    }\n\n    // 5. DIBUJAR SERPIENTE Y VERIFICAR MANZANAS\n    dibujarSerpiente(); \n    comerManzana();\n    dibujarManzanas();\n\n    // 6. CONTROL DE VELOCIDAD CONSTANTE\n    delay(150);\n  }\n}\n\n// --- MOVIMIENTO ARTICULADO ---\nvoid moverSerpiente() {\n  // Cada segmento toma la posición del segmento anterior (de atrás hacia adelante)\n  for (int i = largoActual - 1; i > 0; i--) {\n    cuerpoX[i] = cuerpoX[i - 1];\n    cuerpoY[i] = cuerpoY[i - 1];\n  }\n\n  // La cabeza (índice 0) avanza en la dirección actual\n  switch (dirActual) {\n    case ARRIBA:    cuerpoY[0] -= velocidad; break;\n    case ABAJO:     cuerpoY[0] += velocidad; break;\n    case IZQUIERDA: cuerpoX[0] -= velocidad; break;\n    case DERECHA:   cuerpoX[0] += velocidad; break;\n  }\n}\n\n// --- DIBUJO Y LIMPIEZA ---\nvoid borrarCola() {\n  // 1. Borra el último segmento de la cola\n  int colaX = cuerpoX[largoActual - 1];\n  int colaY = cuerpoY[largoActual - 1];\n  pantalla.fillCircle(colaX, colaY, 3, ST77XX_WHITE);\n\n  // 2. Borra la lengua anterior de la cabeza (pintando de blanco en las 4 posibles direcciones)\n  int cabX = cuerpoX[0];\n  int cabY = cuerpoY[0];\n  pantalla.drawLine(cabX, cabY - 4, cabX, cabY - 5, ST77XX_WHITE); // Arriba\n  pantalla.drawLine(cabX, cabY + 4, cabX, cabY + 5, ST77XX_WHITE); // Abajo\n  pantalla.drawLine(cabX - 4, cabY, cabX - 5, cabY, ST77XX_WHITE); // Izquierda\n  pantalla.drawLine(cabX + 4, cabY, cabX + 5, cabY, ST77XX_WHITE); // Derecha\n}\n\nvoid dibujarSerpiente() {\n  // 1. Dibuja todo el cuerpo (desde el segmento 1 hasta el final)\n  for (int i = 1; i < largoActual; i++) {\n    pantalla.fillCircle(cuerpoX[i], cuerpoY[i], 3, ST77XX_GREEN);\n  }\n\n  // 2. Dibuja la cabeza encima (índice 0) para borrar los ojos anteriores\n  int x = cuerpoX[0];\n  int y = cuerpoY[0];\n  pantalla.fillCircle(x, y, 3, ST77XX_GREEN);\n\n  // 3. Dibuja ojos y lengua roja según la dirección\n  switch (dirActual) {\n    case ARRIBA:\n      pantalla.drawPixel(x - 2, y - 1, ST77XX_BLACK);\n      pantalla.drawPixel(x + 2, y - 1, ST77XX_BLACK);\n      pantalla.drawLine(x, y - 3, x, y - 5, ST77XX_RED);\n      break;\n    case ABAJO:\n      pantalla.drawPixel(x - 2, y + 1, ST77XX_BLACK);\n      pantalla.drawPixel(x + 2, y + 1, ST77XX_BLACK);\n      pantalla.drawLine(x, y + 3, x, y + 5, ST77XX_RED);\n      break;\n    case IZQUIERDA:\n      pantalla.drawPixel(x - 1, y - 2, ST77XX_BLACK);\n      pantalla.drawPixel(x - 1, y + 2, ST77XX_BLACK);\n      pantalla.drawLine(x - 3, y, x - 5, y, ST77XX_RED);\n      break;\n    case DERECHA:\n      pantalla.drawPixel(x + 1, y - 2, ST77XX_BLACK);\n      pantalla.drawPixel(x + 1, y + 2, ST77XX_BLACK);\n      pantalla.drawLine(x + 3, y, x + 5, y, ST77XX_RED);\n      break;\n  }\n}\n\n// --- FUNCIÓN DE VERIFICACIÓN DE MUERTE ---\nbool verificarMuerte() {\n  int x = cuerpoX[0];\n  int y = cuerpoY[0];\n\n  // 1. Verificar colisión con los bordes físicos de la pantalla\n  if (x < 3 || x > (ANCHO_PANTALLA - 3) || y < 3 || y > (ALTO_PANTALLA - 3)) {\n    return true; \n  }\n\n  // 2. Verificar colisión con los obstáculos según el nivel actual\n  if (nivel == 2) {\n    if (x >= 0 && x <= 32 && y >= 0 && y <= 32) return true;\n    if (x >= 105 && x <= 130 && y >= 0 && y <= 27) return true;\n    if (x >= 51 && x <= 81 && y >= 122 && y <= 162) return true;\n  }\n  else if (nivel == 3) {\n    if (x >= 38 && x <= 90 && y >= 0 && y <= 15) return true;\n    if (x >= 34 && x <= 94 && y >= 130 && y <= 160) return true;\n    if (x >= 0 && x <= 23 && y >= 60 && y <= 100) return true;\n  }\n\n  // 3. Verificar colisión consigo misma (empieza desde i = 3 para no chocar con el cuello al doblar)\n  for (int i = 3; i < largoActual; i++) {\n    if (abs(x - cuerpoX[i]) < 4 && abs(y - cuerpoY[i]) < 4) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\n// --- FUNCIONES MENÚ ---\nvoid mostrarMenuInicial() {\n  pantalla.setTextColor(ST77XX_BLACK); \n  pantalla.setTextSize(3);             \n  pantalla.setCursor(25, 35);          \n  pantalla.print(\"Nivel\");\n\n  pantalla.setTextColor(ST77XX_BLACK);\n  pantalla.setTextSize(3);\n  pantalla.setCursor(58, 105);\n  pantalla.print(nivel);\n  pantalla.setCursor(38, 105);\n  pantalla.print(\"<\");\n  pantalla.setCursor(78, 105);\n  pantalla.print(\">\");\n\n  // Dibujar la serpiente quieta en el menú\n  pantalla.fillCircle(65, 75, 3, ST77XX_GREEN); \n  pantalla.fillRect(63, 78, 5, 3, ST77XX_GREEN); \n  pantalla.drawPixel(63, 74, ST77XX_BLACK); \n  pantalla.drawPixel(67, 74, ST77XX_BLACK); \n  pantalla.drawLine(65, 73, 65, 71, ST77XX_RED); \n}\n\nvoid actualizarMenu() {\n  pantalla.fillRect(58, 105, 18, 22, ST77XX_WHITE);\n  pantalla.fillRect(50, 60, 30, 35, ST77XX_WHITE);\n\n  pantalla.setTextColor(ST77XX_BLACK);\n  pantalla.setTextSize(3);\n  pantalla.setCursor(58, 105);\n  pantalla.print(nivel);\n\n  pantalla.fillCircle(65, 75, 3, ST77XX_GREEN);\n  pantalla.fillRect(63, 78, 5, 3, ST77XX_GREEN);\n  pantalla.drawPixel(63, 74, ST77XX_BLACK);\n  pantalla.drawPixel(67, 74, ST77XX_BLACK);\n  pantalla.drawLine(65, 73, 65, 71, ST77XX_RED);\n}\n\nvoid comenzarJuego() {\n  pantalla.fillScreen(ST77XX_WHITE); \n\n  // Inicializar los segmentos iniciales en fila vertical hacia abajo\n  for (int i = 0; i < largoActual; i++) {\n    cuerpoX[i] = 65;\n    cuerpoY[i] = 70 + (i * velocidad);\n  }\n\n  if (nivel == 2) {\n    pantalla.fillRect(0, 0, 30, 30, ST77XX_BLACK);     \n    pantalla.fillRect(103, 0, 25, 25, ST77XX_BLACK);   \n    pantalla.fillRect(49, 120, 30, 40, ST77XX_BLACK);   \n  }\n  else if (nivel == 3) {\n    pantalla.fillRect(38, 0, 52, 15, ST77XX_BLACK);    \n    pantalla.fillRect(34, 130, 60, 30, ST77XX_BLACK);  \n    pantalla.fillRect(0, 60, 23, 40, ST77XX_BLACK);   \n  }\n\n  for (int i = 0; i < cantidadmanzanas; i++) {\n    generarManzanas(i);\n  }\n  \n  dibujarManzanas();\n  dibujarSerpiente();\n}\n\n// --- FUNCIONES DE MANZANAS ---\n\nvoid motorManzanas()\n{\n  digitalWrite(motor,1);\n  delay(500);\n  digitalWrite(motor,0);\n}\n\nvoid generarManzanas(int i) {\n  bool posicionValida = false;\n\n  while (!posicionValida) {\n    manzanaX[i] = random(8, 120);\n    manzanaY[i] = random(18, 152);\n\n    posicionValida = true;\n\n    // 1. Evitar que aparezca encima de la cabeza o el cuerpo\n    for (int k = 0; k < largoActual; k++) {\n      if (abs(manzanaX[i] - cuerpoX[k]) < 10 &&\n          abs(manzanaY[i] - cuerpoY[k]) < 10) {\n        posicionValida = false;\n      }\n    }\n\n    // 2. Evitar que aparezca encima de otra manzana\n    for (int j = 0; j < cantidadmanzanas; j++) {\n      if (j != i &&\n          abs(manzanaX[i] - manzanaX[j]) < 12 &&\n          abs(manzanaY[i] - manzanaY[j]) < 12) {\n        posicionValida = false;\n      }\n    }\n\n    // 3. Obstáculos del nivel 2\n    if (nivel == 2) {\n      if (manzanaX[i] < 36 && manzanaY[i] < 36) posicionValida = false;\n      if (manzanaX[i] > 97 && manzanaY[i] < 31) posicionValida = false;\n      if (manzanaX[i] > 43 && manzanaX[i] < 85 && manzanaY[i] > 114) posicionValida = false;\n    }\n\n    // 4. Obstáculos del nivel 3\n    if (nivel == 3) {\n      if (manzanaX[i] > 32 && manzanaX[i] < 96 && manzanaY[i] < 21) posicionValida = false;\nif (manzanaX[i] > 28 && manzanaX[i] < 100 && manzanaY[i] > 124) posicionValida = false;\nif (manzanaX[i] < 29 && manzanaY[i] > 54 && manzanaY[i] < 106) posicionValida = false;\n}\n}\n}\nvoid dibujarManzanas() {\nfor (int i = 0; i < cantidadmanzanas; i++) {\npantalla.fillCircle(manzanaX[i], manzanaY[i], 4, ST77XX_RED);\npantalla.fillCircle(manzanaX[i] - 2, manzanaY[i] - 2, 2, ST77XX_RED);\npantalla.drawLine(\nmanzanaX[i], manzanaY[i] - 4,\nmanzanaX[i] + 1, manzanaY[i] - 6,\nST77XX_GREEN\n);\n}\n}\nvoid comerManzana() {\nfor (int i = 0; i < cantidadmanzanas; i++) {\nif (abs(cuerpoX[0] - manzanaX[i]) < 7 &&\nabs(cuerpoY[0] - manzanaY[i]) < 7) {\n// Se borra la manzana\npantalla.fillCircle(manzanaX[i], manzanaY[i], 6, ST77XX_WHITE);\n\nmotorManzanas();\n\n// Si no llegó al límite máximo, agrega un segmento nuevo en la cola\nif (largoActual < MAX_LARGO) {\ncuerpoX[largoActual] = cuerpoX[largoActual - 1];\ncuerpoY[largoActual] = cuerpoY[largoActual - 1];\nlargoActual++;\n}\ngenerarManzanas(i);\npuntuacion += 50;\n}\n}\n}\n",
