 "code": "#include <Adafruit_GFX.h>\n#include <Adafruit_ST7735.h>\n#include <SPI.h>\n\n#define TFT_CS 10\n#define TFT_DC 9\n#define TFT_RST 8\n\nAdafruit_ST7735 pantalla = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);\n\nint serpientepos[] = {65, 70}; // Vector de posición de la serpiente [X, Y]\nint velocidad = 4; // Cantidad de píxeles que se mueve en cada paso\n\nconst int PIN_JOYSTICK_X = A0; // Eje X\nconst int PIN_JOYSTICK_Y = A1; // Eje Y\n\nenum Direccion { ARRIBA, ABAJO, IZQUIERDA, DERECHA };\nDireccion dirActual = ARRIBA; // Dirección inicial\n\nvoid setup() {\n  pantalla.initR(INITR_BLACKTAB);\n  pantalla.fillScreen(ST77XX_WHITE); // Pantalla en blanco\n}\n\nvoid loop() {\n  int valorX = analogRead(PIN_JOYSTICK_X);\n  int valorY = analogRead(PIN_JOYSTICK_Y);\n\n  // 1. SOLO DETECTAMOS EL CAMBIO DE DIRECCIÓN (Sin mover aún)\n  if (valorX < 200 && dirActual != DERECHA) {\n    dirActual = IZQUIERDA;\n  } \n  else if (valorX > 800 && dirActual != IZQUIERDA) {\n    dirActual = DERECHA;\n  } \n  else if (valorY < 200 && dirActual != ABAJO) {\n    dirActual = ARRIBA;\n  } \n  else if (valorY > 800 && dirActual != ARRIBA) {\n    dirActual = ABAJO;\n  }\n\n  // 2. EJECUTAMOS EL MOVIMIENTO AUTOMÁTICO EN CADA CICLO\n  borrarSerpiente();\n\n  switch (dirActual) {\n    case ARRIBA:    moverArriba();    break;\n    case ABAJO:     moverAbajo();     break;\n    case IZQUIERDA: moverIzquierda(); break;\n    case DERECHA:   moverDerecha();   break;\n  }\n\n  dibujarSerpiente();\n\n  // 3. CONTROL DE VELOCIDAD CONSTANTE\n  delay(150); \n}\n\n// --- FUNCIONES DE MOVIMIENTO (Solo actualizan la posición) ---\nvoid moverArriba() {\n  serpientepos[1] -= velocidad;\n}\n\nvoid moverAbajo() {\n  serpientepos[1] += velocidad;\n}\n\nvoid moverIzquierda() {\n  serpientepos[0] -= velocidad;\n}\n\nvoid moverDerecha() {\n  serpientepos[0] += velocidad;\n}\n\n// --- FUNCIONES DE DIBUJO Y LIMPIEZA ---\nvoid dibujarSerpiente() {\n  int x = serpientepos[0];\n  int y = serpientepos[1];\n\n  // 1. Dibuja el Cuerpo\n  if (dirActual == ARRIBA)    pantalla.fillRect(x - 2, y + 3, 5, 3, ST77XX_GREEN);\n  if (dirActual == ABAJO)     pantalla.fillRect(x - 2, y - 5, 5, 3, ST77XX_GREEN);\n  if (dirActual == IZQUIERDA) pantalla.fillRect(x + 3, y - 2, 3, 5, ST77XX_GREEN);\n  if (dirActual == DERECHA)   pantalla.fillRect(x - 5, y - 2, 3, 5, ST77XX_GREEN);\n\n  // 2. Dibuja Cabeza\n  pantalla.fillCircle(x, y, 3, ST77XX_GREEN);\n\n  // 3. Dibuja Ojos y Lengua según dirección\n  switch (dirActual) {\n    case ARRIBA:\n      pantalla.drawPixel(x - 2, y - 1, ST77XX_BLACK);\n      pantalla.drawPixel(x + 2, y - 1, ST77XX_BLACK);\n      pantalla.drawLine(x, y - 2, x, y - 4, ST77XX_RED);\n      break;\n    case ABAJO:\n      pantalla.drawPixel(x - 2, y + 1, ST77XX_BLACK);\n      pantalla.drawPixel(x + 2, y + 1, ST77XX_BLACK);\n      pantalla.drawLine(x, y + 2, x, y + 4, ST77XX_RED);\n      break;\n    case IZQUIERDA:\n      pantalla.drawPixel(x - 1, y - 2, ST77XX_BLACK);\n      pantalla.drawPixel(x - 1, y + 2, ST77XX_BLACK);\n      pantalla.drawLine(x - 2, y, x - 4, y, ST77XX_RED);\n      break;\n    case DERECHA:\n      pantalla.drawPixel(x + 1, y - 2, ST77XX_BLACK);\n      pantalla.drawPixel(x + 1, y + 2, ST77XX_BLACK);\n      pantalla.drawLine(x + 2, y, x + 4, y, ST77XX_RED);\n      break;\n  }\n}\n\nvoid borrarSerpiente() {\n  pantalla.fillRect(serpientepos[0] - 7, serpientepos[1] - 7, 14, 14, ST77XX_WHITE);\n}\n",
 "prog": null
}