 "code": "#include <Adafruit_GFX.h>\n#include <Adafruit_ST7735.h>\n#include <SPI.h>\n\n#define TFT_CS  10\n#define TFT_DC  9\n#define TFT_RST 8  \nAdafruit_ST7735 pantalla = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);\nint serpientepos[] = {65,70};    //la posicion inicial de la serpiente\n\n// PINES DEL JOYSTICK\nconst int PIN_JOYSTICK_X = A0; // Eje X para cambiar de nivel\nconst int PIN_JOYSTICK_Y = A1; // Eje Y para arrancar el juego\nconst int PIN_BUZZER = 4;     // Pin del parlante/buzzer\n\nint nivel = 1;\nbool juegoIniciado = false; // Controla si el juego empezó o está en el menú\n\n#define ARRAY_LEN(array) (sizeof(array) / sizeof(array[0]))\n#define Ab5 932\n#define G5 784\n#define A5 880\n#define B5_NOTE 988\n#define Cb6 1109\n#define Fb5 740\n#define Gb5 831\n\nconst int midi1[320][3] = {\n {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0},\n {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0},\n {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200},\n {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0},\n {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0},\n {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0},\n {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0},\n {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0},\n {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0},\n {Cb6, 400, 0}, {Fb5, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200},\n {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {Fb5, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0},\n {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0},\n {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0},\n {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0},\n {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0},\n {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0},\n {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200},\n {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0},\n {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0},\n {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0}, {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0},\n {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {Fb5, 400, 0}, {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0},\n {Ab5, 200, 0}, {G5, 200, 200}, {Ab5, 400, 0}, {A5, 200, 0}, {B5_NOTE, 400, 0}, {G5, 400, 0}, {Cb6, 400, 0}, {Fb5, 400, 0},\n {A5, 600, 0}, {Ab5, 200, 0}, {Fb5, 200, 0}, {Gb5, 1400, 0},\n};\n\n// Variables para el control de la música sin congelar el juego\nint notaActual = 0;\nunsigned long tiempoProximaNota = 0;\nbool notaSonando = false;\n\nvoid gestionarMusica() {\n  unsigned long tiempoActual = millis();\n  \n  if (tiempoActual >= tiempoProximaNota) {\n    if (!notaSonando) {\n      // Toca la siguiente nota\n      tone(PIN_BUZZER, midi1[notaActual][0]);\n      tiempoProximaNota = tiempoActual + midi1[notaActual][1];\n      notaSonando = true;\n    } else {\n      // Termina la nota actual y procesa el silencio intermedio\n      noTone(PIN_BUZZER);\n      tiempoProximaNota = tiempoActual + midi1[notaActual][2];\n      notaSonando = false;\n      \n      // Avanza a la siguiente nota o reinicia la canción\n      notaActual++;\n      if (notaActual >= ARRAY_LEN(midi1)) {\n        notaActual = 0;\n      }\n    }\n  }\n}\n\nvoid setup() \n{\n  pantalla.initR(INITR_BLACKTAB);\n  pantalla.fillScreen(ST77XX_WHITE);\n  \n  pantalla.setTextColor(ST77XX_BLACK); // Color del texto\n  pantalla.setTextSize(3);             // Tamaño del texto (1 es el más chico)\n  pantalla.setCursor(25, 35);          // Posición en la pantalla (X, Y)\n  pantalla.print(\"Nivel\");             // Texto a mostrar\n  \n  pantalla.setTextColor(ST77XX_BLACK); \n  pantalla.setTextSize(3);\n  pantalla.setCursor(58, 105);\n  pantalla.print(\"1\");\n  \n  pantalla.setCursor(38, 105);\n  pantalla.print(\"<\");\n  pantalla.setCursor(78, 105);\n  pantalla.print(\">\");\n  \n  pantalla.fillCircle(serpientepos[0],serpientepos[1],3, ST77XX_GREEN);    //cabeza\n  pantalla.fillRect(serpientepos[0]-2,serpientepos[1]+3, 5, 10, ST77XX_GREEN);    //cuerpo\n  pantalla.drawPixel(serpientepos[0]-2,serpientepos[1]-1, ST77XX_BLACK);    //ojo 1\n  pantalla.drawPixel(serpientepos[0]+2,serpientepos[1]-1, ST77XX_BLACK);    //ojo 2\n  pantalla.drawLine(serpientepos[0], serpientepos[1]-2, serpientepos[0], serpientepos[1]-3, ST77XX_RED);    //Boca/lengua\n}\n\nvoid loop() \n{\n  // Ejecuta la música de fondo en paralelo de forma fluida\n  gestionarMusica();\n\n  // Leer los valores reales del Joystick (rango 15 a 1015)\n  int valorX = analogRead(PIN_JOYSTICK_X);\n  int valorY = analogRead(PIN_JOYSTICK_Y);\n\n  if (!juegoIniciado) {\n    // === MODO SELECCIÓN DE NIVEL ===\n\n    // Si mueven el joystick hacia adelante/arriba (Eje Y cerca del mínimo)\n    if (valorY < 200) { \n      juegoIniciado = true;\n      comenzarJuego(); // Inicia la partida\n    }\n\n    // Si mueven el joystick a la izquierda (Eje X cerca del mínimo) y el nivel es mayor a 1\n    if (valorX < 200 && nivel > 1) {\n      nivel--; // Baja un nivel\n      actualizarMenu();\n      delay(300); // Delay anti-rebote indispensable\n    }\n    // Si mueven el joystick a la derecha (Eje X cerca del máximo) y el nivel es menor a 3\n    else if (valorX > 850 && nivel < 3) {\n      nivel++; // Sube un nivel\n      actualizarMenu();\n      delay(300); // Delay anti-rebote indispensable\n    }\n  } \n  else {\n    // === MODO JUEGO EN MARCHA ===\n    // Acá va a ir la lógica de movimiento que agregue tu amigo\n  }\n}\n\nvoid actualizarMenu() \n{\n  // Borrar número anterior y limpiar la zona central de la serpiente\n  pantalla.fillRect(58, 105, 18, 22, ST77XX_WHITE);\n  pantalla.fillRect(50, 60, 30, 35, ST77XX_WHITE); \n  \n  // Dibujar número actual (1, 2 o 3)\n  pantalla.setTextColor(ST77XX_BLACK);\n  pantalla.setTextSize(3);\n  pantalla.setCursor(58, 105);\n  pantalla.print(nivel); \n  \n  // Dibujar la serpiente quieta de fondo de pantalla\n  pantalla.fillCircle(serpientepos[0],serpientepos[1],3, ST77XX_GREEN);    //cabeza\n  pantalla.fillRect(serpientepos[0]-2,serpientepos[1]+3, 5, 10, ST77XX_GREEN);    //cuerpo\n  pantalla.drawPixel(serpientepos[0]-2,serpientepos[1]-1, ST77XX_BLACK);    //ojo 1\n  pantalla.drawPixel(serpientepos[0]+2,serpientepos[1]-1, ST77XX_BLACK);    //ojo 2\n  pantalla.drawLine(serpientepos[0], serpientepos[1]-2, serpientepos[0], serpientepos[1]-3, ST77XX_RED);    //Boca/lengua\n}\n\nvoid comenzarJuego() {\n  pantalla.fillScreen(ST77XX_WHITE); // Limpiamos la pantalla del menú por completo\n\n  // Nivel 1: No genera ningún bloque negro (Mapa despejado)\n\n  // Si eligió el nivel 2, se dibujan los obstáculos en las esquinas y abajo\n  if (nivel == 2) {\n   pantalla.fillRect(0, 0, 30, 30, ST77XX_BLACK);  // Bloque fijo 1 (Arriba Izquierda)\n   pantalla.fillRect(103, 0, 25, 25, ST77XX_BLACK);  // Bloque fijo 2 (Arriba Derecha)\n   pantalla.fillRect(0, 120, 30, 50, ST77XX_BLACK); // Bloque fijo 3 (Abajo Centro)\n  }\n  // Si eligió el nivel 3, se dibuja un gran obstáculo central (Laberinto/Cruz)\n  else if (nivel == 3) {\n    pantalla.fillRect(50, 0, 90, 15, ST77XX_BLACK);  // Bloque Arriba\n    pantalla.fillRect(54, 130, 80, 35, ST77XX_BLACK);  // Bloque Abajo \n    pantalla.fillRect(10, 60, 23, 75, ST77XX_BLACK);  //Bloque Izquierda \n  }\n\n  // Redibujar la serpiente en su posición de inicio de partida (Corregido)\n  pantalla.fillCircle(serpientepos[0],serpientepos[1],3, ST77XX_GREEN);    //cabeza\n  pantalla.fillRect(serpientepos[0]-2,serpientepos[1]+3, 5, 10, ST77XX_GREEN);    //cuerpo\n  pantalla.drawPixel(serpientepos[0]-2,serpientepos[1]-1, ST77XX_BLACK);    //ojo 1\n  pantalla.drawPixel(serpientepos[0]+2,serpientepos[1]-1, ST77XX_BLACK);    //ojo 2\n  pantalla.drawLine(serpientepos[0], serpientepos[1]-2, serpientepos[0], serpientepos[1]-3, ST77XX_RED);    //Boca/lengua\n}\n",
